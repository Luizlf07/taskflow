# Copie este arquivo para .env e preencha os valores.
# O .env NAO e versionado: nenhuma senha entra no repositorio.
#
#   cp .env.example .env

POSTGRES_USER=taskflow
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=taskflow
PORT=3000

# Usada pela aplicacao quando ela roda fora do compose (npm start, npm test).
# Dentro do compose o host e "banco"; fora dele, "localhost".
DATABASE_URL=postgres://taskflow:troque-esta-senha@localhost:5432/taskflow
